{
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test:e2e": "playwright test",
    "sandcastle": "tsx .sandcastle/main.mts",
    "sandcastle:watch": "SANDCASTLE_MAX_ITERATIONS=infinite tsx .sandcastle/main.mts",
    "sandcastle:service": "node .sandcastle/systemd/install.mjs",
    "sandcastle:check": "tsx .sandcastle/check.mts",
    "sandcastle:test": "tsx --test .sandcastle/issue-pipeline.test.mts .sandcastle/runner-loop.test.mts .sandcastle/systemd/service.test.mjs",
    "sandcastle:build-image": "sandcastle docker build-image --image-name lush-guesser-sandcastle",
    "sandcastle:remove-image": "sandcastle docker remove-image --image-name lush-guesser-sandcastle"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@playwright/test": "^1.60.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
