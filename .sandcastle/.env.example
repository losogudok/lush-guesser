# OpenCode Console API key with an active Go subscription, used by Kimi.
# Legacy OPENCODE_API_KEY is also accepted as a fallback.
OPENCODE_GO_API_KEY=

# Codex roles use the host's ChatGPT login cache. Run codex login on the host.
# No OpenAI API key is needed for subscription access.

# GitHub token used by Sandcastle agents to read and manage GitHub Issues.
# Fine-grained token permissions:
# - Metadata: Read
# - Issues: Read and write
GH_TOKEN=
